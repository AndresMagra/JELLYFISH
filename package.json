{
  "name": "jellyfish",
  "private": true,
  "version": "0.1.0",
  "description": "JELLYFISH — comida congelada a domicilio en República Dominicana",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "tsx scripts/pg-local.ts test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @jellyfish/mobile-core && npm run typecheck -w @jellyfish/customer && npm run typecheck -w @jellyfish/driver && npm run typecheck -w @jellyfish/admin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "catalog:from-xlsx": "tsx scripts/catalog-from-xlsx.ts",
    "photos:apply": "tsx scripts/photos-apply.ts",
    "photos:fetch": "tsx scripts/photos-fetch.ts",
    "brand:assets": "tsx scripts/make-brand-assets.ts",
    "brand:check": "tsx scripts/make-brand-assets.ts --check",
    "e2e:customer": "tsx scripts/e2e-customer.ts",
    "e2e:admin": "tsx scripts/e2e-admin.ts",
    "e2e:pricelist": "tsx scripts/e2e-pricelist.ts",
    "e2e:driver": "tsx scripts/e2e-driver.ts",
    "preview:build": "tsx scripts/build-preview.ts",
    "demo:phone": "tsx scripts/demo-phone.ts",
    "e2e:preview": "tsx scripts/e2e-preview.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  }
}
