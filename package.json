{
  "name": "jellyfish",
  "private": true,
  "version": "0.1.0",
  "description": "JELLYFISH — comida congelada a domicilio en República Dominicana",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @jellyfish/mobile-core && npm run typecheck -w @jellyfish/customer && npm run typecheck -w @jellyfish/driver && npm run typecheck -w @jellyfish/admin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "e2e:customer": "tsx scripts/e2e-customer.ts",
    "e2e:admin": "tsx scripts/e2e-admin.ts",
    "e2e:driver": "tsx scripts/e2e-driver.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  }
}
